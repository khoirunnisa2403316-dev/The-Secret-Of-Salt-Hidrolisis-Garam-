# MEDIA PEMBELAJARAN KIMIA — ENVIRONMENT CONFIGURATION
# Kredensial Firebase Console (Firebase Authentication & Cloud Firestore Database)
# Dapatkan dari: Firebase Console -> Project Settings -> General -> Your apps (Web app)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Catatan: Jika variabel di atas belum diisi, sistem secara otomatis
# mengaktifkan Secure Cryptographic Session Engine lokal (SHA-256 Hashed, No Plaintext Password),
# sehingga aplikasi tetap dapat digunakan dan diuji coba 100% tanpa error koneksi.
