# MEDIA PEMBELAJARAN KIMIA — ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env.local untuk menghubungkan dengan layanan backend Supabase atau Firebase

# [PILIHAN 1: SUPABASE AUTH]
# Dapatkan kredensial proyek dari https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# [PILIHAN 2: FIREBASE AUTH (OPSIONAL)]
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Catatan: Jika variabel di atas dibiarkan kosong, sistem secara otomatis
# mengaktifkan Secure Cryptographic Session Engine lokal (SHA-256 Hashed, No Plaintext Password),
# sehingga aplikasi tetap berfungsi 100% tanpa konfigurasi server tambahan.

